    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://www.curseforge.com/minecraft/mc-mods/project-nublar",
        "sources": "https://github.com/dumbcode/project-nublar"
    },
    "license": "${mod_license}",
    "environment": "*",
    "accessWidener": "projectnublar.accesswidener",
    "entrypoints": {
